# Same API image plus the EPUBs in seed/books/, loaded on every start (idempotent).
# Local testing only: do not push this image to a registry.
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SEED_DIR=/app/seed/books
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && groupadd --system app && useradd --system --gid app app
COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app
COPY scripts/__init__.py scripts/seed_books.py ./scripts/
COPY seed/books ./seed/books
RUN mkdir /data && chown app:app /data
USER app
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && python -m scripts.seed_books && exec uvicorn app.main:app --host 0.0.0.0 --port 8000"]
